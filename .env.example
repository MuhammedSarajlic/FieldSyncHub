# Copy this file to .env and adjust values before running `docker compose up`.
# .env is gitignored, so real secrets never get committed.

# MySQL root password (used by the mysql container and the backend connection string)
DB_PASSWORD=root

# JWT signing key used by the backend to issue/validate access tokens.
# Required - the backend fails to start without it. Generate your own random
# value, at least 64 bytes, and never commit it. For example:
#   openssl rand -base64 64 | tr -d '\n=' | tr '+/' '-_'
JWT_TOKEN=

# Resend (transactional email). Leave blank to run without working email sends.
# Get a key at https://resend.com/api-keys. Until you verify your own sending
# domain there, Resend only accepts the shared onboarding@resend.dev address
# as the sender, and only delivers to the email you signed up to Resend with.
RESEND_API_TOKEN=
RESEND_SENDER_EMAIL=onboarding@resend.dev

# Frontend -> backend API URL as seen from the browser (not from inside Docker)
VITE_BASE_URL=http://localhost:5244/api

# The frontend's own origin (scheme + host + port, no path) as seen from a real
# browser. Used both to build links in emails (password reset, invites) and as the
# API's CORS-allowed origin - set this to your actual deployed frontend URL in any
# environment other than local dev, or the API will reject the browser's requests.
# Comma-separate more than one if needed (e.g. an apex domain and a www subdomain).
VITE_BASE_URL_ORIGIN=http://localhost:5173

# Force the refresh cookie's Secure flag on/off. Leave blank to use the default
# (secure everywhere except local dev), which is correct for almost every setup -
# only set this if you're deploying behind something unusual (e.g. TLS terminated
# by a proxy the backend itself sees as plain HTTP).
COOKIE_SECURE=

# Supabase Storage - uploads are proxied through the backend (see UploadController),
# so only the backend ever holds a Supabase credential. Use the service_role key
# (Project Settings > API), never the anon/public key, and never expose it to the
# frontend. The bucket should be private, not public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Google Sign-In - Client ID from https://console.cloud.google.com/apis/credentials
# (see frontend/.env.example for setup steps). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
