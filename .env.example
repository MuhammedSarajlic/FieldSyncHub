# Copy this file to .env and adjust values before running `docker compose up`.
# .env is gitignored, so real secrets never get committed.

# MySQL root password (used by the mysql container and the backend connection string)
DB_PASSWORD=root

# JWT signing key used by the backend to issue/validate access tokens.
# The default below matches the one currently committed in backend/appsettings.json
# for zero-config local dev. Rotate this (and the appsettings.json copy) before
# using this project outside of a throwaway local environment.
JWT_TOKEN=6niNItCw45h6QmxkFUvy9tTVRea17jDk5IDT6LbgIy9oTf5pA0Jj5ipgePKm6bLhnBMNxw4tJpyhvkfE

# Resend (transactional email). Leave blank to run without working email sends.
# Get a key at https://resend.com/api-keys. Until you verify your own sending
# domain there, Resend only accepts the shared onboarding@resend.dev address
# as the sender, and only delivers to the email you signed up to Resend with.
RESEND_API_TOKEN=
RESEND_SENDER_EMAIL=onboarding@resend.dev

# Frontend -> backend API URL as seen from the browser (not from inside Docker)
VITE_BASE_URL=http://localhost:5244/api

# Google Sign-In - Client ID from https://console.cloud.google.com/apis/credentials
# (see frontend/.env.example for setup steps). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
