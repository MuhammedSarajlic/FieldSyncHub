VITE_BASE_URL=http://localhost:5244/api

# Supabase Storage (replaces Firebase Storage)
# 1. Create a project at https://supabase.com
# 2. In Storage, create a new bucket (name it to match VITE_SUPABASE_STORAGE_BUCKET) and mark it Public
# 3. In Project Settings > API, copy the Project URL and the "anon" public key (never the service_role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=uploads
