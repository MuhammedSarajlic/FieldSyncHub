VITE_BASE_URL=http://localhost:5244/api

# File uploads (company logo, note attachments, quote attachments, pricebook
# images) go through the backend now (see UploadController) - the frontend no
# longer talks to Supabase directly or holds any storage credential. Configure
# Supabase on the backend instead: see ../.env.example / backend/appsettings.example.json.

# Google Sign-In
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (type: Web application)
# 3. Add http://localhost:5173 as an Authorized JavaScript origin
# 4. Copy the Client ID here (no client secret needed for this flow)
VITE_GOOGLE_CLIENT_ID=
